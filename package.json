{
  "name": "punchlist-axi",
  "version": "0.1.1",
  "type": "module",
  "description": "Click-to-edit for any running web app: a proxy injects a picker, your coding agent pulls the batch of notes and edits the source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narze/punchlist-axi.git"
  },
  "homepage": "https://github.com/narze/punchlist-axi#readme",
  "bin": {
    "punchlist-axi": "scripts/punchlist-axi.mjs"
  },
  "files": [
    "scripts/punchlist-axi.mjs",
    "scripts/punchlist-cli.mjs",
    "scripts/client.js",
    "scripts/editor.js",
    "skills/punchlist/SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsx build.ts",
    "typecheck": "tsc -p . && tsc -p src && svelte-check --tsconfig src/client/tsconfig.json --fail-on-warnings --output machine && tsc -p test",
    "lint": "eslint --max-warnings 0 .",
    "check": "pnpm run --silent typecheck && pnpm run --silent lint",
    "pretest": "pnpm run --silent build",
    "test": "node --import tsx test/cli.test.ts && node --import tsx test/proxy.test.ts && node --import tsx test/client.test.ts && node --import tsx test/drag.test.ts && node --import tsx test/ports.test.ts && node --import tsx test/idle.test.ts"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "axi-sdk-js": "^0.1.13",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "jsdom": "^24.0.0",
    "launch-editor": "^2.14.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.11.2"
}
